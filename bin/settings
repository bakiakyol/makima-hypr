#!/usr/bin/env python3
"""settings: a small settings window for this Hyprland setup (GTK4 + libadwaita).

Mouse, touchpad, keyboard, gaps and borders, effects, volume and brightness.

How it works:
	- Every change is applied right away with "hyprctl eval 'hl.config({...})'".
	- The values you changed are kept in config/hypr/settings.json and written out as
	  config/hypr/settings.lua, which hyprland.lua loads last. So hyprland.lua keeps the
	  defaults and this window never edits it. Both files are left out of git.
	- "Reset" deletes both files and reloads Hyprland, back to hyprland.lua's values.
	- Volume and brightness are set on the system (wpctl, brightnessctl), not saved here.

Needs: python-gobject, gtk4, libadwaita (sudo pacman -S python-gobject gtk4 libadwaita)
"""

import json
import os
import subprocess
import sys

# Hyprland sets GTK_THEME=Adwaita:dark for GTK3 apps. With it libadwaita drops its own
# stylesheet, and the palette below (CSS variables) has nothing to override.
os.environ.pop("GTK_THEME", None)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
HYPR = os.path.join(os.path.dirname(HERE), "config", "hypr")
STATE = os.path.join(HYPR, "settings.json")
LUA = os.path.join(HYPR, "settings.lua")

# Pages: (id, title, icon, groups); a group is (title, options).
# Option kinds: ("bool", key, label, subtitle)
#               ("num", key, label, subtitle, min, max, step, digits)
#               ("choice", key, label, subtitle, [(value, label), ...])
PAGES = [
	("mouse", "Fare", "input-mouse-symbolic", [
		("Fare", [
			("bool", "input:natural_scroll", "Doğal kaydırma", "Mac gibi: teker aşağı, sayfa yukarı"),
			("num", "input:sensitivity", "İmleç hızı", "0 = libinput'un normali", -1, 1, 0.05, 2),
			# Unset ("") means libinput's default, which is adaptive for mice
			("choice", "input:accel_profile", "İvme", "Hızlı hareket edince imleç daha çok gitsin mi", [
				("adaptive", "Açık"), ("flat", "Kapalı")]),
			("num", "input:scroll_factor", "Kaydırma miktarı", "Tekerin bir çentiği ne kadar kaydırsın", 0.2, 3, 0.1, 1),
		]),
		("Touchpad", [
			("bool", "input:touchpad:natural_scroll", "Doğal kaydırma", "Mac gibi: parmak yukarı, sayfa yukarı"),
			("bool", "input:touchpad:tap_to_click", "Dokunarak tıkla", None),
			("bool", "input:touchpad:disable_while_typing", "Yazarken kapat", None),
			("num", "input:touchpad:scroll_factor", "Kaydırma miktarı", None, 0.2, 3, 0.1, 1),
		]),
	]),
	("keyboard", "Klavye", "input-keyboard-symbolic", [
		("Klavye", [
			("choice", "input:kb_layout", "Düzen", None, [
				("tr", "Türkçe Q"), ("us", "İngilizce (US)"), ("tr,us", "Türkçe + US")]),
			("num", "input:repeat_delay", "Tekrar gecikmesi", "Basılı tutunca kaç ms sonra tekrarlasın", 150, 1000, 25, 0),
			("num", "input:repeat_rate", "Tekrar hızı", "Saniyede kaç harf", 10, 80, 1, 0),
		]),
	]),
	("look", "Görünüm", "applications-graphics-symbolic", [
		("Pencereler", [
			("num", "general:gaps_in", "İç boşluk", "Pencereler arası (her pencerede, iki katı görünür)", 0, 20, 1, 0),
			("num", "general:gaps_out", "Dış boşluk", "Ekran kenarına", 0, 40, 1, 0),
			("num", "general:border_size", "Kenarlık", "piksel", 0, 8, 1, 0),
			("num", "decoration:rounding", "Köşe yuvarlaklığı", "piksel", 0, 24, 1, 0),
		]),
		("Karartma", [
			("bool", "decoration:dim_inactive", "Odakta olmayanları karart", None),
			("num", "decoration:dim_strength", "Karartma miktarı", None, 0, 0.8, 0.05, 2),
		]),
	]),
	("effects", "Efektler", "starred-symbolic", [
		("Efektler", [
			("bool", "animations:enabled", "Animasyonlar", "Hepsini birden aç/kapa"),
			("bool", "decoration:wobble:enabled", "Jöle efekti", "Sürüklenen pencere sallanır; en çok CPU yiyen efekt"),
			("bool", "decoration:blur:enabled", "Bulanıklık", "Yarı saydam pencerelerin arkası"),
			("bool", "decoration:shadow:enabled", "Gölge", None),
			("bool", "decoration:glow:enabled", "Kızıl parıltı", "Odaktaki pencerenin etrafında"),
		]),
	]),
]

CSS = """
/* Makima palette (design/palette.md). libadwaita 1.6+ reads its colors from these variables. */
:root {
	--accent-bg-color: #e22e0e;
	--accent-fg-color: #e8dccb;
	--accent-color: #f2a33a;
	--window-bg-color: #140b07;
	--window-fg-color: #e8dccb;
	--view-bg-color: #140b07;
	--view-fg-color: #e8dccb;
	--headerbar-bg-color: #22140e;
	--headerbar-fg-color: #e8dccb;
	--card-bg-color: #22140e;
	--card-fg-color: #e8dccb;
	--popover-bg-color: #22140e;
	--popover-fg-color: #e8dccb;
	--dialog-bg-color: #22140e;
	--dialog-fg-color: #e8dccb;
}
scale { min-width: 170px; }
"""


def run(*cmd):
	"""Runs a command; returns (ok, stdout+stderr)."""
	try:
		p = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
	except (OSError, subprocess.TimeoutExpired) as e:
		return False, str(e)
	return p.returncode == 0, (p.stdout + p.stderr).strip()


def get_option(key):
	ok, out = run("hyprctl", "-j", "getoption", key)
	if not ok:
		return None
	try:
		data = json.loads(out)
	except json.JSONDecodeError:
		return None
	for t in ("bool", "int", "float", "str"):
		if t in data:
			v = data[t]
			return "" if v == "[[EMPTY]]" else v
	if "css" in data:  # gaps: "top right bottom left"; this window sets all four the same
		try:
			return int(data["css"].split()[0])
		except (IndexError, ValueError):
			return None
	return None


def lua_value(v):
	if isinstance(v, bool):
		return "true" if v else "false"
	if isinstance(v, (int, float)):
		return repr(v)
	return json.dumps(v, ensure_ascii=False)  # a JSON string is a valid Lua string


def lua_table(values, indent="    "):
	"""{"input:touchpad:tap_to_click": True} -> nested Lua table text."""
	tree = {}
	for key, v in sorted(values.items()):
		node = tree
		*parents, leaf = key.split(":")
		for p in parents:
			node = node.setdefault(p, {})
		node[leaf] = v

	def emit(node, depth):
		pad = indent * depth
		lines = []
		for k, v in node.items():
			if isinstance(v, dict):
				lines.append(f"{pad}{k} = {{")
				lines += emit(v, depth + 1)
				lines.append(f"{pad}}},")
			else:
				lines.append(f"{pad}{k} = {lua_value(v)},")
		return lines

	return "{\n" + "\n".join(emit(tree, 1)) + "\n}"


def load_state():
	try:
		with open(STATE) as f:
			return json.load(f)
	except (OSError, json.JSONDecodeError):
		return {}


def save_state(values):
	with open(STATE, "w") as f:
		json.dump(values, f, indent="\t", sort_keys=True)
	with open(LUA, "w") as f:
		f.write("-- settings.lua: written by bin/settings (the settings window). Don't edit by hand,\n")
		f.write("-- the window rewrites it. hyprland.lua loads it last, so these values win.\n")
		f.write("hl.config(" + lua_table(values) + ")\n")


class Window(Adw.ApplicationWindow):
	def __init__(self, app):
		super().__init__(application=app, title="Ayarlar", default_width=640, default_height=720)
		self.values = load_state()
		self.widgets = {}      # key -> (kind, widget, extra)
		self.loading = True
		self.save_id = 0

		self.toasts = Adw.ToastOverlay()
		stack = Adw.ViewStack()
		for page_id, title, icon, groups in PAGES:
			page = Adw.PreferencesPage()
			for gtitle, options in groups:
				group = Adw.PreferencesGroup(title=gtitle)
				for opt in options:
					group.add(self.make_row(opt))
				page.add(group)
			stack.add_titled_with_icon(page, page_id, title, icon)
		stack.add_titled_with_icon(self.system_page(), "system", "Ses", "audio-volume-high-symbolic")

		header = Adw.HeaderBar()
		switcher = Adw.ViewSwitcher(stack=stack, policy=Adw.ViewSwitcherPolicy.WIDE)
		header.set_title_widget(switcher)
		header.set_decoration_layout(":close")
		reset = Gtk.Button(icon_name="edit-undo-symbolic",
			tooltip_text="Sıfırla: bu pencereden yapılan tüm değişiklikleri geri al")
		reset.connect("clicked", self.on_reset)
		header.pack_start(reset)

		view = Adw.ToolbarView()
		view.add_top_bar(header)
		self.toasts.set_child(stack)
		view.set_content(self.toasts)
		self.set_content(view)

		self.refresh()
		self.loading = False

	# ---------- rows ----------
	def make_row(self, opt):
		kind, key, label, sub = opt[:4]
		if kind == "bool":
			row = Adw.SwitchRow(title=label)
			row.connect("notify::active", lambda r, _p: self.changed(key, r.get_active()))
			self.widgets[key] = (kind, row, None)
		elif kind == "num":
			lo, hi, step, digits = opt[4:]
			row = Adw.ActionRow(title=label)
			scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
			scale.set_digits(digits)
			scale.set_draw_value(True)
			scale.set_value_pos(Gtk.PositionType.LEFT)
			scale.set_hexpand(True)
			scale.set_valign(Gtk.Align.CENTER)

			def on_scale(s, key=key, digits=digits):
				v = round(s.get_value(), digits)
				self.changed(key, int(v) if digits == 0 else v)

			scale.connect("value-changed", on_scale)
			row.add_suffix(scale)
			self.widgets[key] = (kind, scale, digits)
		else:
			choices = opt[4]
			row = Adw.ComboRow(title=label, model=Gtk.StringList.new([c[1] for c in choices]))
			row.connect("notify::selected", lambda r, _p: self.changed(key, choices[r.get_selected()][0]))
			self.widgets[key] = (kind, row, choices)
		if sub:
			row.set_subtitle(sub)
		return row

	def refresh(self):
		"""Shows the values Hyprland is using right now."""
		self.loading = True
		for key, (kind, w, extra) in self.widgets.items():
			v = get_option(key)
			if v is None:
				w.set_sensitive(False)
				continue
			if kind == "bool":
				w.set_active(bool(v))
			elif kind == "num":
				w.set_value(float(v))
			else:
				values = [c[0] for c in extra]
				if v == "":  # unset: libinput's default, the first choice
					v = values[0]
				if v not in values:  # a value set by hand in hyprland.lua: show it too
					extra.append((v, v))
					w.get_model().append(v)
					values.append(v)
				w.set_selected(values.index(v))
		self.loading = False

	# ---------- applying and saving ----------
	def changed(self, key, value):
		if self.loading:
			return
		ok, out = run("hyprctl", "eval", "hl.config(" + lua_table({key: value}) + ")")
		if not ok:
			self.toast("Uygulanamadı: " + (out.splitlines()[-1] if out else "hyprctl hata verdi"))
			return
		self.values[key] = value
		# Sliders send many changes while dragged: save once, shortly after the last one
		if self.save_id:
			GLib.source_remove(self.save_id)
		self.save_id = GLib.timeout_add(600, self.save)

	def save(self):
		self.save_id = 0
		try:
			save_state(self.values)
		except OSError as e:
			self.toast("Kaydedilemedi: " + str(e))
		return False

	def on_reset(self, _button):
		if self.save_id:
			GLib.source_remove(self.save_id)
			self.save_id = 0
		self.values = {}
		for path in (STATE, LUA):
			try:
				os.remove(path)
			except FileNotFoundError:
				pass
		run("hyprctl", "reload")
		GLib.timeout_add(500, self.after_reset)

	def after_reset(self):
		self.refresh()
		self.toast("hyprland.lua'daki değerlere dönüldü")
		return False

	def toast(self, text):
		self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=3))

	# ---------- volume and brightness ----------
	def system_page(self):
		page = Adw.PreferencesPage()
		group = Adw.PreferencesGroup(title="Ses", description="Sistemde ayarlanır, burada kaydedilmez")

		ok, out = run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
		vol, muted = 50.0, False
		if ok and out.startswith("Volume:"):
			vol = float(out.split()[1]) * 100
			muted = "MUTED" in out

		row = Adw.ActionRow(title="Ses seviyesi")
		scale = self.percent_scale(vol, lambda v: run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v}%"))
		scale.set_sensitive(ok)
		row.add_suffix(scale)
		group.add(row)

		mute = Adw.SwitchRow(title="Sessiz", active=muted, sensitive=ok)
		mute.connect("notify::active", lambda r, _p: run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if r.get_active() else "0"))
		group.add(mute)
		page.add(group)

		group = Adw.PreferencesGroup(title="Ekran parlaklığı", description="Laptop ekranı. En az %5, ekran tamamen kararmasın diye")
		ok, out = run("brightnessctl", "-m")
		bright = 50.0
		if ok:
			try:
				bright = float(out.split(",")[3].rstrip("%"))
			except (IndexError, ValueError):
				ok = False
		row = Adw.ActionRow(title="Parlaklık")
		scale = self.percent_scale(bright, lambda v: run("brightnessctl", "-q", "set", f"{max(v, 5)}%"))
		scale.set_sensitive(ok)
		row.add_suffix(scale)
		group.add(row)
		page.add(group)
		return page

	def percent_scale(self, value, setter):
		scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
		scale.set_digits(0)
		scale.set_draw_value(True)
		scale.set_value_pos(Gtk.PositionType.LEFT)
		scale.set_hexpand(True)
		scale.set_valign(Gtk.Align.CENTER)
		scale.set_value(value)
		scale.connect("value-changed", lambda s: setter(int(s.get_value())))
		return scale


class App(Adw.Application):
	def __init__(self):
		super().__init__(application_id="io.github.bakiakyol.makima.settings")

	def do_activate(self):
		win = self.get_active_window()
		if not win:
			Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
			css = Gtk.CssProvider()
			css.load_from_string(CSS)
			Gtk.StyleContext.add_provider_for_display(
				Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
			win = Window(self)
		win.present()


if __name__ == "__main__":
	sys.exit(App().run(sys.argv))

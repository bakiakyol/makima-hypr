#!/bin/sh
# screenshot [select|window|delay]: saves to <Pictures>/Screenshots/ and copies to the clipboard.
#   (nothing)  full screen
#   select     a region picked with the mouse (Esc cancels)
#   window     the focused window
#   delay      full screen after 3 seconds, to catch a menu you open in the meantime
# <Pictures> is your XDG pictures folder (~/.config/user-dirs.dirs), ~/Pictures if there is none.
# Needs grim, slurp and wl-copy.

# fail MESSAGE: error popup, then stop
fail() {
	notify-send -u critical -t 4000 -h string:x-dunst-stack-tag:screenshot "Screenshot failed" "$1"
	exit 1
}

dirs="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
# shellcheck source=/dev/null
[ -r "$dirs" ] && . "$dirs"
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir" || fail "Can't create $dir"

case "$1" in
"" | select | window | delay) ;;
*) echo "usage: screenshot [select|window|delay]" >&2; exit 1 ;;
esac

if [ "$1" = delay ]; then
	notify-send -u low -t 1000 -h string:x-dunst-stack-tag:screenshot "Screenshot in 3 s"
	sleep 3
fi

# Two shots in the same second get "-2", "-3", ... instead of overwriting each other
name=$(date +%Y-%m-%d_%H-%M-%S)
file="$dir/$name.png"
n=2
while [ -e "$file" ]; do
	file="$dir/$name-$n.png"
	n=$((n + 1))
done

if [ "$1" = select ]; then
	# -b: dim  -c: border (crimson)  -s: selected area  -w: border width
	area=$(slurp -b 140b0799 -c e22e0eff -s f2a33a22 -w 2) || exit 0   # Esc cancels
	grim -g "$area" "$file" || fail "grim couldn't save $file"
elif [ "$1" = window ]; then
	# The focused window's position and size from Hyprland, as grim's "x,y wxh"
	area=$(hyprctl -j activewindow | python3 -I -c '
import json, sys
w = json.load(sys.stdin) or {}
if w.get("at"):
	print("%d,%d %dx%d" % (*w["at"], *w["size"]))')
	[ -n "$area" ] || fail "No focused window to capture."
	grim -g "$area" "$file" || fail "grim couldn't save $file"
else
	grim "$file" || fail "grim couldn't save $file"
fi
copy() { wl-copy --type image/png <"$file"; }

# The file is saved at this point; if only the clipboard fails, say so and keep the file
if copy; then
	notify-send -t 2500 -h string:x-dunst-stack-tag:screenshot "Screenshot" "$(basename "$file") · copied to clipboard"
else
	notify-send -t 4000 -h string:x-dunst-stack-tag:screenshot "Screenshot" "$(basename "$file") saved, but couldn't copy it to the clipboard"
fi

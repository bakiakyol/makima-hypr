# battery-warning.timer: checks the battery every 2 minutes
# Source: ~/.config/makima-hypr/config/systemd/battery-warning.timer
# Set up by install.sh. To turn it off: systemctl --user disable --now battery-warning.timer
[Unit]
Description=Check the battery every 2 minutes (makima-hypr)

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target

#!/bin/bash
# anim-bench: a repeatable animation workload with CPU/GPU measurement (Super+Ctrl+T).
#
# For about 30 s it runs the same moves every time, on workspace 9: opens and closes
# windows, switches workspaces, floats a window and drags it in steps (wobble), shows a
# special workspace, opens fuzzel and a notification. Meanwhile it samples, every 0.5 s:
#   cpu   whole-machine CPU busy %
#   hypr  Hyprland's own CPU, % of one core
#   gpu   Intel GPU busy % (time outside the RC6 sleep state)
#   mhz   GPU clock
# The averages go to ~/.local/state/makima-hypr/bench.tsv, labeled with the text in
# ~/.local/state/makima-hypr/bench-label (or "unlabeled"), and pop up as a notification.
#
# Run it with the screen on and Hyprland visible: on another TTY nothing is drawn.
# Don't touch the keyboard or mouse while it runs.

set -u
state=~/.local/state/makima-hypr
mkdir -p "$state"
label=$(cat "$state/bench-label" 2>/dev/null || echo unlabeled)
gpu=$(ls -d /sys/bus/pci/devices/0000:00:02.0/drm/card* 2>/dev/null | head -1)
hpid=$(pgrep -x Hyprland | head -1)
samples=$(mktemp)

d() { hyprctl dispatch "$1" >/dev/null; }
bench_addrs() {
	hyprctl -j clients | python3 -I -c '
import json, sys
print(" ".join(c["address"] for c in json.load(sys.stdin) if c["class"] == "bench"))'
}

# ---------- sampler ----------
sample() {
	read -r _ a b c idle e f g _ < /proc/stat; pt=$((a+b+c+idle+e+f+g)); pi=$idle
	ph=$(awk '{print $14+$15}' /proc/$hpid/stat)
	pr=$(cat "$gpu/power/rc6_residency_ms"); pms=$(date +%s%3N)
	while :; do
		sleep 0.5
		read -r _ a b c idle e f g _ < /proc/stat; t=$((a+b+c+idle+e+f+g))
		h=$(awk '{print $14+$15}' /proc/$hpid/stat); r=$(cat "$gpu/power/rc6_residency_ms"); ms=$(date +%s%3N)
		dt=$((t-pt)); dms=$((ms-pms))
		cpu=$(( (dt-(idle-pi))*100/dt ))
		hyp=$(( (h-ph)*100*$(nproc)/dt ))
		gbusy=$(( 100 - (r-pr)*100/dms )); [ $gbusy -lt 0 ] && gbusy=0
		echo "$cpu $hyp $gbusy $(cat "$gpu/gt_act_freq_mhz")" >>"$samples"
		pt=$t; pi=$idle; ph=$h; pr=$r; pms=$ms
	done
}

start_ws=$(hyprctl -j activeworkspace | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["id"])')
d 'hl.dsp.focus({ workspace = 9 })'
sleep 1
sample & sampler=$!

for round in 1 2 3; do
	# Open three windows
	for i in 1 2 3; do d 'hl.dsp.exec_cmd("foot --app-id bench")'; sleep 0.8; done
	# Workspace switches
	for i in 1 2; do d 'hl.dsp.focus({ workspace = 8 })'; sleep 0.6; d 'hl.dsp.focus({ workspace = 9 })'; sleep 0.6; done
	set -- $(bench_addrs)
	# Float one and drag it in steps (wobble, window move animation)
	if [ $# -ge 1 ]; then
		d "hl.dsp.window.float({ action = \"set\", window = \"address:$1\" })"; sleep 0.4
		for step in 1 2 3 4 5 6 7 8; do
			[ $((step % 2)) = 0 ] && x=-80 || x=80
			d "hl.dsp.window.move({ x = $x, y = 40, relative = true, window = \"address:$1\" })"; sleep 0.15
		done
	fi
	# Special workspace: move one there, show it, hide it
	if [ $# -ge 2 ]; then
		d "hl.dsp.window.move({ workspace = \"special:bench\", follow = false, window = \"address:$2\" })"; sleep 0.4
		d 'hl.dsp.workspace.toggle_special("bench")'; sleep 0.7
		d 'hl.dsp.workspace.toggle_special("bench")'; sleep 0.7
	fi
	# A layer: fuzzel, and a notification
	fuzzel & fz=$!; sleep 0.8; kill $fz 2>/dev/null
	notify-send -t 1000 -h string:x-dunst-stack-tag:bench "anim-bench" "round $round"; sleep 0.6
	# Close them all
	for a in $(bench_addrs); do d "hl.dsp.window.close({ window = \"address:$a\" })"; sleep 0.5; done
	sleep 0.5
done

kill $sampler 2>/dev/null; wait $sampler 2>/dev/null
d "hl.dsp.focus({ workspace = $start_ws })"

summary=$(awk '{n++; c+=$1; h+=$2; g+=$3; m+=$4; if($2>mh)mh=$2} END {
	printf "cpu %d%%  hypr %d%% (max %d)  gpu %d%%  %d MHz  (%d samples)", c/n, h/n, mh, g/n, m/n, n }' "$samples")
printf '%s\t%s\t%s\n' "$(date +%F\ %T)" "$label" "$summary" >>"$state/bench.tsv"
rm -f "$samples"
notify-send -t 15000 -h string:x-dunst-stack-tag:bench "anim-bench: $label" "$summary"
